<%- include('../partials/head') %>
<main id="contenido" class="site-container login-section"><div class="login-intro"><p class="eyebrow">Administración de la memoria</p><h1>Un espacio cuidado<br>para la comunidad.</h1><p>Revisa las reflexiones de los visitantes y acompaña la conversación sobre los encuentros.</p><a class="text-link" href="/">Volver al inicio <svg class="icon"><use href="#i-arrow"/></svg></a></div><form action="/admin/login" method="post" class="login-form"><p class="eyebrow">Acceso privado</p><h2>Iniciar sesión</h2><p>Ingresa con tu cuenta de administración.</p><% if(error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="mb-3"><label class="form-label" for="email">Correo electrónico</label><input class="form-control" id="email" name="email" type="email" maxlength="254" autocomplete="username" required></div><div class="mb-4"><label class="form-label" for="password">Contraseña</label><input class="form-control" id="password" name="password" type="password" maxlength="72" autocomplete="current-password" required></div><button class="btn btn-primary w-100" type="submit">Entrar a administración <svg class="icon"><use href="#i-arrow"/></svg></button></form></main>
<%- include('../partials/footer') %>
