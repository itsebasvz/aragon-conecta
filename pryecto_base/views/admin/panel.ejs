<%- include('../partials/head') %>
<main id="contenido"><div class="page-heading"><div class="site-container"><div class="section-heading"><div><p class="eyebrow">Administración</p><h1>Moderación de comentarios</h1><p class="page-lead">Revisa los envíos antes de compartirlos con la comunidad.</p></div><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-primary" type="submit">Cerrar sesión</button></form></div></div></div><section class="site-container section"><form class="admin-filters" method="get" action="/admin"><div><label class="form-label" for="estado">Estado</label><select class="form-select" name="estado" id="estado"><option value="">Todos los estados</option><% for(const s of ['pendiente','aprobado','rechazado']) { %><option value="<%= s %>"<%= estado === s ? ' selected' : '' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option><% } %></select></div><div><label class="form-label" for="conferencia">Conferencia</label><select class="form-select" name="conferencia" id="conferencia"><option value="">Todas las conferencias</option><% for(const c of conferencias) { %><option value="<%= c.slug %>"<%= slug === c.slug ? ' selected' : '' %>><%= c.contenido.corto %></option><% } %></select></div><button class="btn btn-primary" type="submit">Aplicar filtros</button><a href="/admin">Limpiar</a></form><p class="admin-count"><%= count %> comentario<%= count === 1 ? '' : 's' %> en esta selección</p><% if(!comentarios.length) { %><div class="empty-comments"><svg class="icon"><use href="#i-message"/></svg><h2>Todo al día</h2><p>No hay comentarios en esta selección.</p></div><% } %><div class="moderation-list"><% for(const c of comentarios) { %><article class="moderation-card"><header><div><strong><%= c.nombre %></strong><span> · <%= formatCommentDate(c.createdAt) %></span></div><span class="status-badge status-<%= c.estado %>"><%= c.estado %></span></header><a class="moderation-event" href="/conferencias/<%= c.conferencia.slug %>"><%= c.conferencia.titulo %></a><p class="moderation-message"><%= c.mensaje %></p><div class="moderation-actions"><form action="/admin/comentarios/<%= c.id %>?_method=PUT" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="visually-hidden" for="estado-<%= c.id %>">Estado del comentario de <%= c.nombre %></label><select class="form-select" name="estado" id="estado-<%= c.id %>"><% for(const s of ['pendiente','aprobado','rechazado']) { %><option value="<%= s %>"<%= c.estado === s ? ' selected' : '' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option><% } %></select><button class="btn btn-primary" type="submit">Guardar estado</button></form><details class="delete-confirmation"><summary>Eliminar comentario</summary><form action="/admin/comentarios/<%= c.id %>?_method=DELETE" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><input type="checkbox" name="confirmar" value="eliminar" required> Confirmo que quiero eliminarlo permanentemente.</label><button class="btn btn-outline-danger" type="submit">Eliminar definitivamente</button></form></details></div></article><% } %></div><% if(paginas > 1) { %><nav class="pagination-row" aria-label="Páginas de comentarios"><% if(pagina > 1) { %><a class="btn btn-outline-primary" href="/admin?pagina=<%= pagina-1 %>&amp;estado=<%= estado %>&amp;conferencia=<%= slug %>">Anterior</a><% } %><span>Página <%= pagina %> de <%= paginas %></span><% if(pagina < paginas) { %><a class="btn btn-outline-primary" href="/admin?pagina=<%= pagina+1 %>&amp;estado=<%= estado %>&amp;conferencia=<%= slug %>">Siguiente</a><% } %></nav><% } %></section></main>
<%- include('../partials/footer') %>
