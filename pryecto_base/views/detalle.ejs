<%- include('partials/head', { flash: null }) %>
<main id="contenido">
  <div class="site-container detail-breadcrumb"><nav aria-label="Ruta de navegación"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item"><a href="/conferencias">Conferencias</a></li><li class="breadcrumb-item active" aria-current="page"><%= conferencia.contenido.corto %></li></ol></nav></div>
  <section class="detail-hero site-container"><div><p class="eyebrow"><%= conferencia.categoria %></p><h1><%= conferencia.titulo %></h1><p class="page-lead"><%= conferencia.resumen %></p><div class="detail-state">Evento realizado · Memoria académica</div><a class="text-link" href="#comentarios">Compartir una reflexión <svg class="icon"><use href="#i-arrow"/></svg></a></div><figure><img src="<%= conferencia.contenido.imagen.src %>" width="<%= conferencia.contenido.imagen.width %>" height="<%= conferencia.contenido.imagen.height %>" alt="<%= conferencia.contenido.imagen.alt %>" fetchpriority="high"><figcaption><%= conferencia.contenido.imagen.caption %></figcaption></figure></section>
  <div class="site-container detail-layout section">
    <article class="detail-article"><section><p class="eyebrow">El encuentro</p><h2>Una mirada a la conferencia</h2><p class="article-intro"><%= conferencia.contenido.introduccion %></p></section>
      <% if(conferencia.contenido.programa.length) { %><section class="article-section"><h2>Un encuentro, tres perspectivas</h2><p>Las intervenciones acercaron experiencias profesionales y proyectos a la comunidad universitaria.</p><div class="programme"><% conferencia.contenido.programa.forEach((bloque,i)=> { %><article><span class="programme-number"><%= String(i+1).padStart(2,'0') %></span><div><h3><%= bloque.titulo %></h3><p class="programme-speaker"><%= bloque.participantes %></p><p><%= bloque.texto %></p></div></article><% }) %></div></section><% } %>
      <section class="article-section"><h2>Temas que nos dejó el encuentro</h2><% for(const bloque of conferencia.contenido.secciones) { %><div class="topic-block"><h3><%= bloque.titulo %></h3><p><%= bloque.texto %></p></div><% } %></section>
      <section class="takeaways article-section"><p class="eyebrow">Para llevar a la práctica</p><h2>Aprendizajes principales</h2><ol><% for(const idea of conferencia.contenido.aprendizajes) { %><li><%= idea %></li><% } %></ol></section>
      <section class="article-section"><h2>Participantes</h2><div class="people-grid"><% for(const persona of conferencia.contenido.ponentes) { %><div class="person"><span class="person-initial" aria-hidden="true"><%= persona.nombre.replace('Dr. ','').charAt(0) %></span><div><h3><%= persona.nombre %></h3><p><%= persona.rol %></p></div></div><% } %></div></section>
      <p class="source-note"><strong>Fuente de la reseña:</strong> <%= conferencia.contenido.fuente %></p>
    </article>
    <aside class="event-sidebar" aria-label="Información del evento"><div class="sidebar-panel"><p class="eyebrow">Datos del encuentro</p><dl><dt>Periodo académico</dt><dd>2027-1</dd><% if(conferencia.fecha) { %><dt>Fecha</dt><dd><%= formatDate(conferencia.fecha) %></dd><% } %><% if(conferencia.horario) { %><dt>Horario</dt><dd><%= conferencia.horario %><small>Ciudad de México</small></dd><% } %><% if(conferencia.sede) { %><dt>Sede</dt><dd><%= conferencia.sede %></dd><% } %><dt>Comunidad</dt><dd><%= conferencia.contenido.organizador %></dd></dl><span class="archived-label">Evento realizado</span></div><div class="sidebar-note"><h2>Ingeniería que conecta</h2><p>Esta memoria reúne una selección de actividades de la Semana de Ingeniería de FES Aragón.</p><a class="text-link" href="/conferencias">Explorar otros encuentros <svg class="icon"><use href="#i-arrow"/></svg></a></div></aside>
  </div>
  <% if (conferencia.contenido.fotos.length > 1 || conferencia.contenido.materiales.length) { %>
  <section class="gallery-band"><div class="site-container section"><% if (conferencia.contenido.fotos.length > 1) { %><p class="eyebrow">Registro del encuentro</p><h2 id="encuentro-fotos-title">Así se vivió</h2><%- include('partials/photo-carousel', { fotos: conferencia.contenido.fotos }) %><% } %><% if(conferencia.contenido.materiales.length) { %><div class="materials"><h2>Materiales del evento</h2><% for(const material of conferencia.contenido.materiales) { %><a class="material-link" href="<%= material.url %>"><div><h3><%= material.titulo %></h3><p><%= material.detalle %></p></div><svg class="icon"><use href="#i-open"/></svg></a><% } %></div><% } %><% if(conferencia.slug === 'hello-world') { %><p class="club-link"><a class="text-link" href="https://helloworld-unam.tech/">Visitar el sitio de Hello World <svg class="icon"><use href="#i-open"/></svg></a></p><% } %></div></section>
  <% } %>
  <%- include('partials/community') %>
</main>
<%- include('partials/footer') %>
