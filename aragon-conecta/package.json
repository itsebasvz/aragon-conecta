{
  "name": "semana-ingenieria-fes-aragon",
  "version": "1.0.0",
  "description": "Memoria de la Semana de Ingeniería 2027-1 · FES Aragón, UNAM",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "server": "nodemon index.js",
    "db:init": "node scripts/db-init.js",
    "db:seed": "node scripts/db-seed.js",
    "test": "node --test --test-concurrency=1 tests/integration.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "setup": "node scripts/setup-env.js",
    "admin:password": "node scripts/admin-password.js"
  },
  "keywords": [
    "express",
    "mariadb",
    "sequelize"
  ],
  "author": "itsebasvz",
  "license": "MIT",
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "connect-session-sequelize": "^8.0.6",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.4",
    "method-override": "^3.0.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    },
    "nodemon": {
      "chokidar": "4.0.3"
    }
  }
