<%# Panel privado de moderación. Recibe comentarios, contadores y filtros del controlador; sus acciones funcionan con formularios HTML. -%>
<%- include('../partials/head', { flash: null }) %>
<main id="contenido">
  <div class="page-heading admin-page-heading"><div class="site-container"><div class="section-heading"><div><p class="eyebrow">Administración · Comunidad</p><h1>Moderación de comentarios</h1><p class="page-lead">Un espacio cuidado empieza con una buena conversación. Revisa, publica y da seguimiento a cada reflexión.</p></div><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-primary" type="submit">Cerrar sesión</button></form></div></div></div>
  <section class="site-container section admin-workspace" aria-label="Revisión de comentarios">
<%# Las tarjetas muestran el total por estado dentro de la búsqueda y conferencia elegidas. -%>
    <nav class="admin-summary" aria-label="Filtrar por estado">
      <% for (const item of [{state:'', key:'todos', title:'Todos', note:'En esta selección'}, {state:'pendiente', key:'pendiente', title:'Pendientes', note:'Esperan tu revisión'}, {state:'aprobado', key:'aprobado', title:'Aprobados', note:'Visibles en la web'}, {state:'rechazado', key:'rechazado', title:'Rechazados', note:'Ocultos al público'}]) { %>
        <a class="admin-summary-card summary-<%= item.key %>" href="<%= filterUrl(item.state) %>" aria-label="<%= item.title %>: <%= totals[item.key] %>"<% if (estado === item.state) { %> aria-current="page"<% } %>><span class="summary-title"><span class="summary-dot" aria-hidden="true"></span><%= item.title %></span><strong><%= totals[item.key] %></strong><span class="summary-note"><%= item.note %></span></a>
      <% } %>
    </nav>
<%# GET coloca los filtros en la URL, por lo que pueden conservarse al navegar entre páginas. -%>
    <form class="admin-filters" method="get" action="/admin">
      <% if (estado) { %><input type="hidden" name="estado" value="<%= estado %>"><% } %>
      <div><label class="form-label" for="buscar-comentario">Buscar comentario</label><input class="form-control" type="search" name="q" id="buscar-comentario" value="<%= q %>" maxlength="120" placeholder="Nombre o palabras de la reflexión"></div>
      <div><label class="form-label" for="conferencia">Conferencia</label><select class="form-select" name="conferencia" id="conferencia"><option value="">Todas las conferencias</option><% for (const c of conferencias) { %><option value="<%= c.slug %>"<%= slug === c.slug ? ' selected' : '' %>><%= c.contenido.corto %></option><% } %></select></div>
      <button class="btn btn-primary" type="submit">Aplicar filtros</button><a href="/admin">Limpiar filtros</a>
    </form>
<%# La confirmación aparece debajo de los filtros y cerca de los resultados. -%>
    <% if (flash) { %><div class="alert alert-<%= flash.type %> admin-feedback" id="moderacion-feedback" role="status" tabindex="-1"><%= flash.message %></div><% } %>
    <div class="admin-results-heading"><h2><%= estado === 'pendiente' ? 'Por revisar' : estado === 'aprobado' ? 'Comentarios publicados' : estado === 'rechazado' ? 'Comentarios rechazados' : 'Todas las reflexiones' %><span class="comment-count"><%= count %></span></h2><p>Más recientes primero<%# La paginación conserva los filtros y sólo ofrece anterior o siguiente cuando corresponda. -%>
<% if (paginas > 1) { %> · Página <%= pagina %> de <%= paginas %><% } %></p></div>
<%# El mensaje vacío se adapta a una búsqueda sin resultados o a un estado sin comentarios. -%>
    <% if (!comentarios.length) { %><div class="empty-comments admin-empty"><svg class="icon" aria-hidden="true"><use href="#i-message"/></svg><h2><%= q || slug ? 'Sin resultados en esta selección' : estado === 'pendiente' ? 'Todo al día' : 'Aún no hay comentarios aquí' %></h2><p><%= q || slug ? 'Prueba otras palabras o consulta todas las conferencias.' : estado === 'pendiente' ? 'No quedan reflexiones pendientes de revisión.' : 'Las nuevas reflexiones llegarán a Pendientes para que puedas revisarlas.' %></p><% if (q || slug || estado) { %><a class="text-link" href="/admin">Ver todos los comentarios <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a><% } %></div><% } %>
    <div class="moderation-list">
<%# Cada tarjeta corresponde a un comentario e indica su conferencia y su estado actual. -%>
      <% for (const c of comentarios) { %>
        <article class="moderation-card" data-state="<%= c.estado %>">
          <header><%- include('../partials/comment-author', { nombre: c.nombre, fecha: c.createdAt }) %><span class="status-badge status-<%= c.estado %>"><span aria-hidden="true">●</span> <%= c.estado === 'pendiente' ? 'Por revisar' : c.estado === 'aprobado' ? 'Publicado' : 'Rechazado' %></span></header>
          <a class="moderation-event" href="/conferencias/<%= c.conferencia.slug %>"><svg class="icon" aria-hidden="true"><use href="#i-open"/></svg><%= c.conferencia.titulo %></a>
          <p class="moderation-message"><%= c.mensaje %></p>
          <p class="moderation-state-help"><%= c.estado === 'pendiente' ? 'Este comentario aún no es público. Decide si se comparte con la comunidad.' : c.estado === 'aprobado' ? 'Este comentario es visible en la conferencia.' : 'Este comentario está oculto al público. Puedes revisarlo de nuevo.' %></p>
<%# Los botones envían sólo el estado nuevo. _method permite expresar PUT desde un formulario POST. -%>
          <div class="moderation-actions">
            <form action="/admin/comentarios/<%= c.id %>?_method=PUT" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="volver" value="<%= returnTo %>">
              <% if (c.estado !== 'aprobado') { %><button class="btn btn-primary" type="submit" name="estado" value="aprobado">Aprobar <svg class="icon" aria-hidden="true"><use href="#i-check"/></svg></button><% } %>
              <% if (c.estado !== 'rechazado') { %><button class="btn btn-outline-danger" type="submit" name="estado" value="rechazado">Rechazar</button><% } %>
              <% if (c.estado !== 'pendiente') { %><button class="btn btn-outline-primary" type="submit" name="estado" value="pendiente">Devolver a pendientes</button><% } %>
            </form>
<%# Eliminar requiere abrir la confirmación y marcar la casilla. El campo volver conserva los filtros del panel. -%>
            <details class="delete-confirmation"><summary>Eliminar comentario</summary><form action="/admin/comentarios/<%= c.id %>?_method=DELETE" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="volver" value="<%= returnTo %>"><label><input type="checkbox" name="confirmar" value="eliminar" required> Confirmo que quiero eliminarlo permanentemente.</label><button class="btn btn-outline-danger" type="submit">Eliminar definitivamente</button></form></details>
          </div>
        </article>
      <% } %>
    </div>
    <% if (paginas > 1) { %><nav class="pagination-row" aria-label="Páginas de comentarios"><% if (pagina > 1) { %><a class="btn btn-outline-primary" href="<%= filterUrl(estado, pagina - 1) %>">Anterior</a><% } %><span>Página <%= pagina %> de <%= paginas %></span><% if (pagina < paginas) { %><a class="btn btn-outline-primary" href="<%= filterUrl(estado, pagina + 1) %>">Siguiente</a><% } %></nav><% } %>
  </section>
</main>
<%- include('../partials/footer') %>
