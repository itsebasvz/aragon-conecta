<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="#002F6C">
  <title><%= title %> · FES Aragón, UNAM</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/sitio.css">
  <script src="/js/sitio.js" defer></script>
</head>
<body>
<svg class="icon-definitions" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></symbol>
  <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18m-14 4h2m4 0h2m-8 3h2"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
  <symbol id="i-open" viewBox="0 0 24 24"><path d="M14 4h6v6m0-6L10 14M10 4H4v16h16v-6"/></symbol>
  <symbol id="i-message" viewBox="0 0 24 24"><path d="M21 14a3 3 0 0 1-3 3H9l-6 4V6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3Z"/><path d="M7 8h10M7 12h7"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
</defs></svg>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="institutional-header">
  <div class="site-container identity-row">
    <a href="https://www.unam.mx/" class="institution-logo"><img src="/media/logo-unam.svg" width="541" height="137" alt="Universidad Nacional Autónoma de México"></a>
    <span class="identity-divider" aria-hidden="true"></span>
    <a href="https://www.aragon.unam.mx/fes-aragon/#!/inicio" class="institution-logo"><img src="/media/logo-fes-aragon.svg" width="541" height="137" alt="Facultad de Estudios Superiores Aragón"></a>
    <div class="header-context"><span>Divulgación y comunidad</span><strong>Semana de Ingeniería</strong><span>Semestre 2027-1</span></div>
  </div>
</header>
<nav class="site-nav" aria-label="Navegación principal">
  <div class="site-container nav-row">
    <span class="mobile-nav-label">Semana de Ingeniería</span>
    <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" hidden><svg class="icon"><use href="#i-menu"/></svg><span>Menú</span></button>
    <div class="nav-links" id="nav-links" data-open="false">
    <% for (const item of [{href:'/', text:'Inicio'}, {href:'/conferencias',text:'Conferencias'}, {href:'/acerca',text:'Acerca del proyecto'}]) { const active = item.href === '/' ? path === '/' : path.startsWith(item.href); %>
      <a href="<%= item.href %>"<% if(active) { %> aria-current="page"<% } %>><%= item.text %></a>
    <% } %>
    </div>
    <span class="nav-edition">FES Aragón <span aria-hidden="true">/</span> 2027-1</span>
  </div>
</nav>
<% if (flash) { %><div class="site-container flash-wrap"><div class="alert alert-<%= flash.type %>" role="status"><%= flash.message %></div></div><% } %>
