<section class="section site-container comments-section" id="comentarios" aria-labelledby="comments-title">
  <div class="section-heading"><div><p class="eyebrow">Una conversación abierta</p><h2 id="comments-title">Reflexiones de la comunidad</h2><p><%= conferencia.contenido.pregunta %></p></div><a class="text-link" href="#nombre">Sumar mi reflexión <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
  <div class="comments-layout">
    <div class="comments-feed">
      <div class="comments-feed-heading"><h3>Lo que comparte la comunidad</h3><span class="comment-count"><%= comentarios.length %> publicada<%= comentarios.length === 1 ? '' : 's' %></span></div>
      <p class="comments-feed-note">Las reflexiones más recientes aparecen primero.</p>
      <div class="comment-list">
        <% if (!comentarios.length) { %>
          <div class="empty-comments"><svg class="icon" aria-hidden="true"><use href="#i-message"/></svg><h3>La primera idea puede ser la tuya</h3><p>Comparte una pregunta, un aprendizaje o algo que te gustaría poner en práctica.</p><a class="text-link" href="#nombre">Iniciar la conversación <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
        <% } %>
        <% for (const comentario of comentarios) { %>
          <article class="comment">
            <header><%- include('comment-author', { nombre: comentario.nombre, fecha: comentario.createdAt }) %><svg class="icon comment-mark" aria-hidden="true"><use href="#i-message"/></svg></header>
            <p class="comment-message"><%= comentario.mensaje %></p>
            <span class="comment-public-note">Una idea para seguir conversando</span>
          </article>
        <% } %>
      </div>
    </div>
    <form class="comment-form" action="/conferencias/<%= conferencia.slug %>/comentarios" method="post" data-comment-form>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="comment-form-heading"><span class="comment-form-icon" aria-hidden="true"><svg class="icon"><use href="#i-message"/></svg></span><div><p class="eyebrow">Tu voz también cuenta</p><h3>Comparte tu reflexión</h3></div></div>
      <p class="form-help">No necesitas una cuenta. Comparte con respeto: revisamos cada envío antes de publicarlo.</p>
      <ol class="comment-steps" aria-label="Proceso de publicación"><li><span>1</span>Escribes</li><li><span>2</span>Revisamos</li><li><span>3</span>Compartimos</li></ol>
      <div class="mb-3"><label class="form-label" for="nombre">Nombre visible</label><input class="form-control" id="nombre" name="nombre" minlength="2" maxlength="60" autocomplete="nickname" placeholder="Tu nombre o un alias" required value="<%= values.nombre || '' %>" aria-describedby="nombre-help error-nombre"<% if (errors.nombre) { %> aria-invalid="true"<% } %>><p class="input-hint" id="nombre-help">Así aparecerás junto a tu comentario.</p><p class="field-error" id="error-nombre" data-error="nombre"><%= errors.nombre || '' %></p></div>
      <div class="mb-3"><label class="form-label" for="mensaje">Tu reflexión</label><textarea class="form-control" id="mensaje" name="mensaje" rows="5" minlength="10" maxlength="1500" placeholder="¿Qué idea te llevas de este encuentro?" required aria-describedby="mensaje-help error-mensaje"<% if (errors.mensaje) { %> aria-invalid="true"<% } %>><%= values.mensaje || '' %></textarea><div class="textarea-help" id="mensaje-help"><span>Entre 10 y 1500 caracteres</span><span data-character-count aria-hidden="true"><%= (values.mensaje || '').length %>/1500</span></div><progress class="textarea-progress" data-character-progress max="1500" value="<%= (values.mensaje || '').length %>" aria-label="Caracteres utilizados"></progress><p class="field-error" id="error-mensaje" data-error="mensaje"><%= errors.mensaje || '' %></p></div>
      <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="acepto" value="si" id="acepto" required aria-describedby="error-acepto"><label class="form-check-label" for="acepto">Leí la <a href="/privacidad">información sobre comentarios</a> y acepto publicar mi nombre y reflexión si se aprueban.</label><p class="field-error" id="error-acepto" data-error="acepto"><%= errors.acepto || '' %></p></div>
      <div class="form-status" role="status" tabindex="-1"<% if (!flash) { %> hidden<% } %>><%= flash?.message || '' %></div>
      <button class="btn btn-primary" type="submit">Enviar a revisión <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button>
      <p class="comment-form-footnote">Tu comentario aparecerá cuando sea aprobado.</p>
    </form>
  </div>
</section>
