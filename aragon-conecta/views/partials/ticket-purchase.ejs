<%# Precio y botón para una conferencia, identificada por slug. El catálogo de boletos está disponible en todas las vistas mediante app.locals. -%>
<% const boleto = catalogoBoletos.find((item) => item.slug === slug); if (boleto) { %>
<div class="ticket-purchase">
<%# formatMoney convierte los centavos al precio que ve la persona. -%>
  <div class="ticket-price"><span>Boleto por persona</span><p><strong><%= formatMoney(boleto.precioCentavos) %></strong> <span>MXN</span></p></div>
<%# data-add-ticket identifica la conferencia para carrito.js. El botón se habilita cuando el script está listo. -%>
  <button class="btn btn-primary ticket-add" type="button" data-add-ticket="<%= slug %>" disabled><svg class="icon" aria-hidden="true"><use href="#i-cart"/></svg><span data-add-label>Agregar al carrito</span><span class="visually-hidden">: <%= boleto.titulo %></span></button>
</div>
<% } %>
