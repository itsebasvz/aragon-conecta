<%# Nombre y fecha reutilizados en comentarios públicos y privados. La fecha visible usa el formato común del servidor. -%>
<div class="comment-author">
<%# Forma las iniciales con hasta dos palabras. Array.from mantiene completos los caracteres Unicode. -%>
  <span class="comment-avatar" aria-hidden="true"><%= nombre.trim().split(/\s+/u).slice(0, 2).map(word => Array.from(word)[0]).join('').toLocaleUpperCase('es-MX') %></span>
  <div class="comment-identity"><strong><%= nombre %></strong><time datetime="<%= fecha.toISOString() %>"><%= formatCommentDate(fecha) %></time></div>
</div>
