# Plantilla de configuración: setup-env.js crea a partir de ella un .env propio con claves
# nuevas. Los valores de este archivo son ejemplos.
# development es el modo local; production activa opciones como cookies seguras.
NODE_ENV=development
# Dirección donde escucha Node: 127.0.0.1 sólo acepta conexiones locales; Compose usa
# 0.0.0.0 dentro del contenedor.
HOST=127.0.0.1
# Puerto del servidor web en el equipo donde se ejecuta.
PORT=2800
# Actívalo sólo cuando la aplicación esté detrás de un proxy confiable configurado para
# ella.
TRUST_PROXY=0
# Datos para conectar con MariaDB: base, usuario, contraseña, dirección y puerto.
BD_NOMBRE=semana_ingenieria
BD_USUARIO=semana
BD_CLAVE=CAMBIA_ESTA_CLAVE_DE_BASE_DE_DATOS
BD_HOST=127.0.0.1
BD_PORT=3306
# Clave del administrador de MariaDB que utiliza el contenedor durante su preparación.
BD_ROOT_CLAVE=CAMBIA_ESTA_CLAVE_ROOT
# Clave privada con la que Express protege la cookie de sesión; debe ser larga y
# aleatoria.
SESSION_SECRET=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Credenciales para crear el administrador inicial. El seed no cambia la contraseña de un
# administrador ya existente.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIA_POR_UNA_CONTRASENA_UNICA
